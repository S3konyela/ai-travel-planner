# Google Gemini — powers the AI itinerary generator (src/lib/itinerary/generate.ts).
# Get a key at aistudio.google.com/apikey.
# Without this set, the app falls back to demo/mock itineraries.
GEMINI_API_KEY=

# Google Maps — used for the destination map embed (src/components/MapEmbed.tsx).
# Enable the "Maps Embed API" for this key. Without it, a placeholder is shown.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase — used to persist generated itineraries and guesthouse booking
# requests (supabase/schema.sql). Without these set, itineraries aren't saved
# and the "Request to book" button on guesthouse cards returns an error.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Quicket — powers the "Live events during your trip" list (src/lib/events/quicket.ts).
# Get a key at developer.quicket.co.za (My Account > API Keys). Server-only — never
# expose it to the client. Without it, the events section is simply hidden.
QUICKET_API_KEY=
